# HALVETH Web-Edition 2026.11. Statische Website, kein PHP noetig.
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
AddType text/javascript .mjs
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
</IfModule>
<IfModule mod_alias.c>
  RedirectMatch 404 (^|/)\.git(/|$)
</IfModule>
<FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:py|pyc|rar|zip|tar|gz|bak|sqlite|db)|.*(?:PRIVATE_KEY|credentials).*)$">
  Require all denied
</FilesMatch>

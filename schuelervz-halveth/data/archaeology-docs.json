600 Pixel) <a href=\"http://www.schuelervz.net/\" target=\"_blank\"> <img alt=\"\" src=\"http://www.schuelervz.net/http://static.schuelervz.net/images/pvz/banner/sky_160x600.gif\" border=\"0\" /> </a> Kontakt AGB Presse Impressum Datenschutz Jugendschutz Verhaltenskodex","links":["http://schuelervz.net/contact.php","http://schuelervz.net/contactdata.php","http://schuelervz.net/help.php","http://schuelervz.net/home.php","http://schuelervz.net/impressum.php","http://schuelervz.net/invite.php","http://schuelervz.net/login.php","http://schuelervz.net/policy.php","http://schuelervz.net/press.php","http://schuelervz.net/protectminor.php","http://schuelervz.net/register.php","http://schuelervz.net/rules.php","http://schuelervz.net/terms.php","http://static.schuelervz.net/css/pvz/styles.css","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f01.jpg","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f01.png","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f02.jpg","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f02.png","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f03.jpg","http://static.schuelervz.net/images/pvz/banner/banner_180x100_f03.png","http://static.schuelervz.net/images/pvz/banner/schuelervz_microbutton.gif","http://static.schuelervz.net/images/pvz/banner/sky_160x600.gif","http://static.schuelervz.net/images/pvz/favicon.ico","http://static.schuelervz.net/js/pvz/countdown.js","http://static.schuelervz.net/js/pvz/prototype.js","http://static.schuelervz.net/js/pvz/studivz.js"],"local_file":"archive/expanded/d2fb4dab9edecd84783c05ea.html","capture_url":"https://web.archive.org/web/20070223071406id_/http://www.schuelervz.net:80/banner.php","source":"CDX_AUTONOMOUS","ingest_state":"BUNDLED_PUBLIC"},{"timestamp":"20070223212046","original":"http://www.schuelervz.net?c=2d25c0348718a8e3cbc3233a8b801aabfe5f75f4/robots.txt","statuscode":"200","mimetype":"text/html","digest":"FU5BLKQNESE4734VCMTP4GN3ER7Z